{
  "name": "@orcestr/ui",
  "version": "0.5.7",
  "description": "Accessible React components and styles for application interfaces.",
  "author": "Artasov",
  "license": "MPL-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Artasov/orcestr-ui.git"
  },
  "homepage": "https://github.com/Artasov/orcestr-ui#readme",
  "bugs": {
    "url": "https://github.com/Artasov/orcestr-ui/issues"
  },
  "sideEffects": [
    "./dist/styles/*.css",
    "./dist/example/*.css"
  ],
  "files": [
    "dist",
    "docs",
    "README.md",
    "README.ru.md",
    "LICENSE",
    "NOTICE",
    "TRADEMARKS.md",
    "assets"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./styles.css": "./dist/styles/orcestr-ui.css",
    "./example/styles.css": "./dist/example/styles.css",
    "./example/UiExamplePage": {
      "types": "./dist/example/UiExamplePage.d.ts",
      "import": "./dist/example/UiExamplePage.js"
    },
    "./react-query": {
      "types": "./dist/react-query.d.ts",
      "import": "./dist/react-query.js"
    }
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', {recursive: true, force: true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && npm run build:styles && npm run check:package",
    "build:styles": "sass src/styles/orcestr-ui.sass dist/styles/orcestr-ui.css --style=compressed --no-source-map && sass src/example/styles.sass dist/example/styles.css --style=compressed --no-source-map",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:package": "node scripts/check-package-exports.mjs",
    "check": "npm run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs,json,md,yml,yaml}\"",
    "pack:dry-run": "npm pack --dry-run",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/run-tests.mjs"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.99.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.6.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/react-query": "5.99.2",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^28.0.3",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "axe-core": "^4.12.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.4",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-icons": "5.6.0",
    "sass": "^1.101.0",
    "tsx": "^4.23.0",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "esbuild@0.28.1": true
  }
}
